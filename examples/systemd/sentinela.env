# /etc/sentinela/sentinela.env  (chmod 640, root:sentinela)
SENTINELA_LISTEN=127.0.0.1:8090
SENTINELA_AUTH_MODE=local
SENTINELA_USERS_FILE=/etc/sentinela/users.txt
SENTINELA_LAPI_URL=http://127.0.0.1:8080
SENTINELA_LAPI_MACHINE_ID=sentinela
SENTINELA_LAPI_PASSWORD_FILE=/etc/sentinela/lapi_password
SENTINELA_METRICS_URL=http://127.0.0.1:6060/metrics
SENTINELA_CSCLI_MODE=exec
SENTINELA_CSCLI_COMMAND=sudo -n /usr/bin/cscli
SENTINELA_RELOAD_COMMAND=sudo -n /usr/bin/systemctl reload crowdsec
# Traefik on the same host:
SENTINELA_TRUSTED_PROXIES=127.0.0.1/32
# Set to false only if you reach Sentinela over plain HTTP (e.g. inside a VPN):
SENTINELA_COOKIE_SECURE=true
